{
  "name": "mermaid-element",
  "version": "1.0.1",
  "description": "A custom element that displays Mermaid Diagrams with dynamic version support",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "prepublishOnly": "if [ -z $PUBLISH ]; then echo 'This package must be published using `npm run pub`\\n' && exit 1; fi",
    "pub": "PUBLISH=true npm run build && npm publish ./dist",
    "start": "npx -y serve src",
    "dev": "npx -y serve src",
    "deploy": "netlify deploy --dir=src --prod"
  },
  "keywords": [
    "mermaid",
    "custom-element",
    "web-components",
    "diagram",
    "chart",
    "flowchart",
    "sequence-diagram"
  ],
  "author": {
    "name": "Bramus Van Damme",
    "email": "bramus@bram.us",
    "url": "https://www.bram.us/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bramus/mermaid-element.git"
  },
  "bugs": {
    "url": "https://github.com/bramus/mermaid-element/issues"
  },
  "homepage": "https://github.com/bramus/mermaid-element#readme"
}
